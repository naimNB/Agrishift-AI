# .env file — এখানে secrets রাখো, কখনো git এ push করো না!

# JWT Secret (যেকোনো random string দাও)
SECRET_KEY=agrishift-super-secret-key-change-in-production-2024

# Database (default: SQLite, সহজ dev setup)
DATABASE_URL=sqlite:///./agrishift.db

# PostgreSQL এ migrate করতে চাইলে uncomment করো:
# DATABASE_URL=postgresql://user:password@localhost:5432/agrishift_db
