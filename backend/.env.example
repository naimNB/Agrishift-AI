# AgriShift AI Backend — Environment Configuration Template
# Duplicate this file as '.env' in this directory and populate with your environment values.
# NEVER commit your actual '.env' file or production credentials to version control.

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Server Networking
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# CORS Configuration
# For production web clients, specify comma-separated domains (e.g. https://agrishift.web.app,https://myfarm.com)
# For mobile native API consumption, '*' can be used safely.
CORS_ORIGINS=*

# JWT Secret Key
# CRITICAL: In production (ENVIRONMENT=production), the application will refuse to start
# if SECRET_KEY is left at default or is shorter than 32 characters.
# Generate a secure key: `openssl rand -hex 32`
SECRET_KEY=change-this-to-a-strong-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# SQLite (default for development):
DATABASE_URL=sqlite:///./agrishift.db
# PostgreSQL (recommended for production on Supabase, Neon, or Render):
# DATABASE_URL=postgresql://user:password@ep-sample.aws.neon.tech/agrishift?sslmode=require

# NASA POWER API Endpoint & Caching
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_CACHE_TTL_SECONDS=3600
NASA_REQUEST_TIMEOUT=20.0

# Geographic Center / Default Reference (North Bengal, Bangladesh)
NORTH_BENGAL_LAT=24.8465
NORTH_BENGAL_LON=89.3773
