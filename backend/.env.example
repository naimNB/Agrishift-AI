# AgriShift AI Backend — Environment Configuration Template
# Duplicate this file as '.env' in this directory and populate with your environment values.
# NEVER commit your actual '.env' file to version control.

# Application Environment (development | staging | production)
ENVIRONMENT=development

# JWT Secret Key
# Generate a strong key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-this-to-a-strong-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection
# SQLite (default for development):
DATABASE_URL=sqlite:///./agrishift.db
# PostgreSQL (production option):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/agrishift_db

# NASA POWER API Endpoint
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Geographic Center / Default Reference (North Bengal, Bangladesh)
NORTH_BENGAL_LAT=24.7471
NORTH_BENGAL_LON=90.3915
